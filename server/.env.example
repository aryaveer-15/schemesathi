PORT=5000
MONGO_URI=
JWT_SECRET=

# Canonical origin for production API writes, link previews, and crawler files.
# On Render and in production use an HTTPS origin with no path, query, or credentials.
# PUBLIC_SITE_ORIGIN=
# If PUBLIC_SITE_ORIGIN is unset on Render, the app uses Render's RENDER_EXTERNAL_URL.
# Render supplies RENDER_EXTERNAL_URL. Leave it unset locally.

# The full Content Security Policy defaults to report-only. Set enforce to block violations.
# CSP_MODE=report-only

# Exact local frontend origins, comma-separated. Leave unset for same-origin Render deployments.
# For the local Docker HTTP workflow, use NODE_ENV=development and SERVE_CLIENT=true.
# CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Set only when the app is reachable exclusively through this many trusted proxies.
# TRUST_PROXY_HOPS=1
# Optional comma-separated MongoDB DNS resolver override for the API and catalogue importer.
# MONGO_DNS_SERVERS=
