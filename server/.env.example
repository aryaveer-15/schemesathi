PORT=5000
MONGO_URI=
JWT_SECRET=
# Optional HTTPS origin for public link previews. Render provides RENDER_EXTERNAL_URL.
# PUBLIC_SITE_ORIGIN=
# Optional full CSP mode. Leave report-only for the first deployment.
# CSP_MODE=report-only
# Optional for a separate frontend origin, comma separated
# CORS_ORIGINS=https://schemes.example.org
# Set only when the app is reachable exclusively through this many trusted proxies
# TRUST_PROXY_HOPS=1
# Optional MongoDB SRV resolver override, comma separated
# MONGO_DNS_SERVERS=
